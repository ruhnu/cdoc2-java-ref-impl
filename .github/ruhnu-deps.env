# Git refs of ruhnu sibling repos built by .github/workflows/ruhnu-images.yml
# before cdoc2-cli. Their artifacts are not published to any Maven repo CI can
# reach, so they are built and installed into the local Maven repo.
#
# The refs must produce the versions this branch's poms depend on
# (cdoc2-auth-token in cdoc2-lib; cdoc2-key-shares-openapi and the other
# *-openapi documents in cdoc2-client). On a feature branch, point them at the
# matching sibling feature branches. The commits actually built are recorded in
# the image labels io.github.ruhnu.<repo>.revision.
CDOC2_OPENAPI_REF=feat/add-did-recipient
CDOC2_AUTH_REF=feat/add-did-recipient
